GEMINI_API_KEY=your-gemini-key
RESEND_API_KEY=your-resend-key
HUNTER_API_KEY=your-hunter-key
TO_EMAIL=you@example.com
# optional
FROM_EMAIL=onboarding@resend.dev
SENDER_NAME=Your Name
GEMINI_MODEL_FAST=gemini-3-flash-preview
GEMINI_MODEL_STRONG=gemini-3.1-pro-preview
GEMINI_MODEL_GROUNDING=gemini-3-flash-preview
GEMINI_MIN_INTERVAL=6.5
# true = drafts wait in the Queue for your approval before anything is sent
REQUIRE_APPROVAL=true
